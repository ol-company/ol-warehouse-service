{
  "name": "ol-warehouse-service",
  "version": "0.1.0",
  "private": true,
  "description": "Service nghiệp vụ mẫu của OL-Platform: kho, mặt hàng, điều chỉnh tồn kho theo tenant (PostgreSQL RLS)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --import @ol/node-kit/otel-register dist/main.js",
    "migrate": "node --enable-source-maps dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "db:new": "node scripts/new-migration.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ol/node-kit": "npm:@ol-company/node-kit@^0.1.0",
    "awilix": "^12.0.5",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@testcontainers/postgresql": "^11.2.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.0",
    "jose": "^6.0.11",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "testcontainers": "^11.2.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
